# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://hzzt:hzzt_dev_password@localhost:5432/hzzt_dev?sslmode=disable
TEST_DATABASE_URL=postgres://hzzt:hzzt_test_password@localhost:5433/hzzt_test?sslmode=disable

# Auth
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
